.nox/

# Logs and local runtime state
*.log
logs/
run/
tmp/
temp/

# Datasets: retain only documentation and directory sentinels
/data/*
!/data/README.md
!/data/raw/
!/data/interim/
!/data/processed/
/data/raw/*
/data/interim/*
/data/processed/*
!/data/raw/.gitkeep
!/data/interim/.gitkeep
!/data/processed/.gitkeep

# Model weights, exports, and experiment outputs
/models/*
!/models/README.md
/checkpoints/
/artifacts/
/mlruns/
/wandb/

# Docker image archives are release artifacts, not source files.
/project-phantom*.tar
/project-phantom*.tar.gz

# Notebook checkpoints and editor/OS files
.ipynb_checkpoints/
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
