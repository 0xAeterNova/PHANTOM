# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Python environments and generated artifacts
.venv/
.venv*/
venv/
env/
__pycache__/
*.py[cod]
*.pyd
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Test, type-check, lint, and coverage state
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.mypy_cache/
.pip-audit-cache/
.pre-commit-cache/
.pytest_cache/
.ruff_cache/
