# Only application source and build inputs may enter the Docker build context.
# Local environments, secrets, participant data, and downloaded weights stay out.
**
!Dockerfile
!pyproject.toml
!requirements-docker.txt
!README.md
!LICENSE
!docs/
!docs/third_party_tts.md
!src/
!src/**
!app/
!app/**
!configs/
!configs/*.yaml
!prompts/
!prompts/*.md
!prompts/*.yaml
!scripts/
!scripts/docker_entrypoint.py
!scripts/container_smoke.py
!scripts/check_realtime_models.py
!scripts/setup_piper_tts.py

# These exclusions also apply inside the allowed source directories.
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.log
**/*.wav
**/*.mp3
**/*.mp4
**/*.onnx
**/*.pt
**/*.safetensors
