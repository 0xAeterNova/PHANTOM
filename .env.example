# Copy this file to .env for local development. Never commit the populated .env.
# Docker Compose also reads this file, but forwards only variables named in its
# environment section. The image/profile controls PHANTOM_CONFIG in containers.
# The scripts/run_realtime.py launcher selects realtime_cpu.yaml by default and
# realtime_demo.yaml with --demo. PHANTOM_CONFIG is primarily useful when app.realtime
# is imported directly (for example, with uvicorn).

PHANTOM_CONFIG=configs/realtime_demo.yaml
PHANTOM_LOG_LEVEL=INFO

# Docker-only settings. Both profiles still publish exclusively on 127.0.0.1.
# PHANTOM_PORT=8001
# PHANTOM_REAL_MEMORY=8g
# PHANTOM_REAL_CPUS=4.0

# Optional validated overrides. Leave them commented to use the selected YAML profile.
# PHANTOM_RUNTIME_MODE=real
# PHANTOM_LLM_PROVIDER=transformers

# Used only when llm.backend is openai-compatible and llm.api_key_env keeps its default.
# Never put the key in YAML, source code, screenshots, or version control.
# PHANTOM_LLM_API_KEY=

# Host and port are launcher arguments, for example:
# python scripts/run_realtime.py --port 8001
# No PHANTOM_HOST, PHANTOM_PORT, or PHANTOM_API_BASE_URL variable is consumed by
# the integrated Python launcher. PHANTOM_PORT is a Docker Compose setting only.
