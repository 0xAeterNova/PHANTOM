* text=auto

# Linux container inputs must not inherit Windows CRLF line endings.
Dockerfile text eol=lf
Makefile text eol=lf
.dockerignore text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.txt text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
